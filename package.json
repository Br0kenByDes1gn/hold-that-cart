{
  "name": "hold-that-cart",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:server": "tsx watch src/server/dev.ts",
    "dev:client": "vite --port 5173",
    "build": "vite build && pnpm run build:server",
    "build:server": "esbuild src/server/dev.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --external:@electric-sql/pglite --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:vision": "VISION_TESTS=1 vitest run tests/vision --no-file-parallelism",
    "vision:render": "tsx scripts/render-vision-preview.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "assets:normalize": "node scripts/normalize-assets.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@hono/node-server": "^1.13.8",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.95.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "esbuild": "^0.28.2",
    "hono": "^4.6.20",
    "lucide-react": "^1.63.0",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.30.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
